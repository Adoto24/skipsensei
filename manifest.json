{
  "manifest_version": 3,
  "name": "SkipSensei",
  "version": "1.0",
  "description": "Ajoute un bouton flottant pour sauter l'intro des animes sur un site de streaming.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://api.jikan.moe/*",
    "https://api.aniskip.com/*",
    "https://graphql.anilist.co/*",
    "https://relations.yuna.moe/*",
    "https://raw.githubusercontent.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://anime-sama.to/*",
        "*://*.anime-sama.to/*",
        "*://voiranime.rip/*",
        "*://*.voiranime.rip/*"
      ],
      "js": ["resolution.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://vidmoly.to/*",
        "*://vidmoly.biz/*",
        "*://video.sibnet.ru/*",
        "*://sendvid.com/*"
      ],
      "all_frames": true,
      "js": ["player-frame.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "SkipSensei",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
